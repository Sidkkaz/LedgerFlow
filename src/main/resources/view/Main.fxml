<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ledgerflow.controller.MainController">

    <left>
        <AnchorPane maxHeight="400.0" maxWidth="144.0" minHeight="400.0" minWidth="144.0" prefHeight="400.0" prefWidth="144.0" style="-fx-background-color: #0001;">
            <children>
            <HBox prefHeight="63.0" prefWidth="144.0">
               <children>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../assents/LedgerLogo.png" />
                     </image>
                     <HBox.margin>
                        <Insets left="5.0" top="15.0" />
                     </HBox.margin>
                  </ImageView>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
            
            
                            <Label text="LEDGERFLOW">
                                <textFill>
                                    <LinearGradient endX="1.0" endY="1.0">
                                        <stops>
                                            <Stop>
                                                <color>
                                                    <Color red="0.6800000071525574" green="0.44777604937553406" blue="0.17679999768733978" />
                                                </color>
                                            </Stop>
                                            <Stop offset="1.0">
                                                <color>
                                                    <Color red="0.4000000059604645" green="0.25337931513786316" blue="0.1599999964237213" />
                                                </color>
                                            </Stop>
                                        </stops>
                                    </LinearGradient>
                                </textFill>
                                <font>
                                    <Font name="Poppins Medium" size="12.0" />
                                </font>
                           <padding>
                              <Insets top="20.0" />
                           </padding>
                            </Label>
                        <Label prefHeight="17.0" prefWidth="77.0" text="Gestão Financeira">
                           <font>
                              <Font name="Poppins Regular" size="8.0" />
                           </font>
                           <padding>
                              <Insets bottom="5.0" />
                           </padding>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Region layoutY="59.0" prefHeight="3.0" prefWidth="145.0" styleClass="divider-dark" stylesheets="@style.css" />
            <Separator layoutX="143.0" orientation="VERTICAL" prefHeight="400.0" />

                <VBox layoutY="53.0" prefHeight="349.0" prefWidth="144.0" spacing="10.0" BorderPane.alignment="CENTER">
               <Label text="Principais" textFill="#616161">
                  <font>
                     <Font name="Poppins Regular" size="10.0" />
                  </font>
                  <padding>
                     <Insets left="5.0" />
                  </padding>
               </Label>
                    <Button layoutX="200.0" mnemonicParsing="false" onAction="#AbrirMenu" prefHeight="26.0" prefWidth="148.0" style="-fx-background-color: transparent; -fx-alignment: left;" text="🏠  Inicio">
                  <font>
                     <Font name="Calibri" size="12.0" />
                  </font></Button>
               <Button layoutX="10.0" layoutY="67.0" mnemonicParsing="false" onAction="#AbrirLancamento" prefHeight="26.0" prefWidth="146.0" style="-fx-background-color: transparent; -fx-alignment: left;" text="📄  Lançamentos">
                  <font>
                     <Font name="Calibri" size="12.0" />
                  </font></Button>
               <Button layoutX="10.0" layoutY="104.0" mnemonicParsing="false" onAction="#AbrirRelatorio" prefHeight="26.0" prefWidth="146.0" style="-fx-background-color: transparent; -fx-alignment: left;" text="📊  Relatórios">
                  <font>
                     <Font name="Calibri" size="12.0" />
                  </font></Button>
               <Region prefHeight="3.0" prefWidth="144.0" styleClass="divider-dark" stylesheets="@style.css" />
               <Label layoutX="10.0" layoutY="30.0" text="Cadastros" textFill="#616161">
                  <font>
                     <Font name="Poppins Regular" size="10.0" />
                  </font>
                  <padding>
                     <Insets left="5.0" />
                  </padding>
               </Label>
                    <Button mnemonicParsing="false" onAction="#AbrirConta" prefHeight="26.0" prefWidth="146.0" style="-fx-background-color: transparent; -fx-alignment: left;" text="📙 Contas">
                  <font>
                     <Font name="Calibri" size="12.0" />
                  </font></Button>
               <Button layoutX="10.0" layoutY="104.0" mnemonicParsing="false" onAction="#AbrirCategoria" prefHeight="26.0" prefWidth="146.0" style="-fx-background-color: transparent; -fx-alignment: left;" text="🏷 Categorias">
                  <font>
                     <Font name="Calibri" size="12.0" />
                  </font></Button>
               <Region layoutX="10.0" layoutY="163.0" prefHeight="3.0" prefWidth="144.0" styleClass="divider-dark" stylesheets="@style.css" />
               <HBox prefHeight="33.0" prefWidth="144.0">
                  <children>
                     <Button mnemonicParsing="false" onAction="#AbrirConfiguracoes" prefHeight="26.0" prefWidth="146.0" style="-fx-background-color: transparent;" text="⚙">
                        <font>
                           <Font name="Calibri" size="15.0" />
                        </font></Button>
                     <Button mnemonicParsing="false" onAction="#Sair" prefHeight="35.0" prefWidth="144.0" style="-fx-background-color: transparent;" text="⬅️" textFill="RED" />
                  </children>
                  <VBox.margin>
                     <Insets top="30.0" />
                  </VBox.margin>
               </HBox>
               <padding>
                  <Insets top="20.0" />
               </padding>
                </VBox>
            </children></AnchorPane>

    </left>

    <center>
        <StackPane fx:id="content" />
    </center>

</BorderPane>
