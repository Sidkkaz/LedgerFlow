<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ledgerflow.controller.MainController">

    <left>
        <AnchorPane maxHeight="400.0" maxWidth="144.0" minHeight="400.0" minWidth="144.0" prefHeight="400.0" prefWidth="144.0" style="-fx-background-color: #0001;">
            <children>
            <Separator layoutX="143.0" orientation="VERTICAL" prefHeight="400.0" />


                <Label layoutX="4.0" layoutY="8.0" text="LEDGERFLOW">
                    <textFill>
                        <LinearGradient endX="1.0" endY="1.0">
                            <stops>
                                <Stop>
                                    <color>
                                        <Color red="0.6800000071525574" green="0.44777604937553406" blue="0.17679999768733978" />
                                    </color>
                                </Stop>
                                <Stop offset="1.0">
                                    <color>
                                        <Color red="0.4000000059604645" green="0.25337931513786316" blue="0.1599999964237213" />
                                    </color>
                                </Stop>
                            </stops>
                        </LinearGradient>
                    </textFill>
                    <font>
                        <Font name="Poppins Medium" size="12.0" />
                    </font>
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" translateX="10.0">
                     <image>
                        <Image url="@../assents/LedgerLogo.png" />
                     </image>
                  </ImageView>
               </graphic>
                </Label>

                <VBox alignment="TOP_CENTER" layoutY="40.0" prefHeight="360.0" prefWidth="144.0" spacing="10.0" BorderPane.alignment="CENTER">
                    <Button layoutX="200.0" mnemonicParsing="false" onAction="#AbrirMenu" prefHeight="26.0" prefWidth="147.0" style="-fx-background-color: transparent;" text="HOME" textAlignment="CENTER">
                  <font>
                     <Font name="Poppins Regular" size="12.0" />
                  </font></Button>
                    <Button mnemonicParsing="false" onAction="#AbrirConta" prefHeight="26.0" prefWidth="146.0" style="-fx-background-color: transparent;" text="CONTAS" />
               <Button layoutX="10.0" layoutY="67.0" mnemonicParsing="false" onAction="#AbrirLancamento" prefHeight="26.0" prefWidth="146.0" style="-fx-background-color: transparent;" text="LANÇAMENTOS" />
               <Button layoutX="10.0" layoutY="104.0" mnemonicParsing="false" onAction="#AbrirRelatorio" prefHeight="26.0" prefWidth="146.0" style="-fx-background-color: transparent;" text="RELATÓRIOS" />
               <Button layoutX="10.0" layoutY="140.0" mnemonicParsing="false" onAction="#AbrirConfiguracoes" prefHeight="26.0" prefWidth="146.0" style="-fx-background-color: transparent;" text="CONFIGURAÇÕES" />
               <Button layoutX="10.0" layoutY="177.0" mnemonicParsing="false" onAction="#Sair" prefHeight="26.0" prefWidth="146.0" style="-fx-background-color: transparent;" text="SAIR" textFill="#a60000" />
               <padding>
                  <Insets top="20.0" />
               </padding>
                </VBox>
            </children></AnchorPane>

    </left>

    <center>
        <StackPane fx:id="content" />
    </center>

</BorderPane>
